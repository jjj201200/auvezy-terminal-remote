{
  "name": "auvezy-terminal-remote",
  "version": "0.17.0",
  "type": "module",
  "description": "Auvezy Terminal Remote — 局域网内通过手机/平板浏览器远程控制 PC 终端：atr <program>，多终端多实例自动出现在浏览器 tab 切换",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": false,
  "homepage": "https://github.com/jjj201200/auvezy-terminal-remote",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjj201200/auvezy-terminal-remote.git"
  },
  "bugs": {
    "url": "https://github.com/jjj201200/auvezy-terminal-remote/issues"
  },
  "keywords": [
    "terminal",
    "remote",
    "pty",
    "claude",
    "claude-code",
    "lan",
    "mobile",
    "websocket",
    "xterm"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "atr": "dist/cli.js"
  },
  "files": [
    "dist",
    "frontend-dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "bundle": "node ../scripts/bundle-backend.js",
    "dev": "tsx watch src/cli.ts --dev-proxy",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "node dist/postinstall.mjs",
    "prepublishOnly": "echo 'prepublishOnly: 由 root pnpm build 处理'"
  },
  "dependencies": {
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "5.5.0",
    "cookie": "^1.0.0",
    "cors": "^2.8.5",
    "didyoumean2": "^7.0.4",
    "express": "^4.21.0",
    "http-proxy": "^1.18.1",
    "node-pty": "^1.0.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.4",
    "pino": "^9.5.0",
    "prompts": "^2.4.2",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^20.17.0",
    "@types/picomatch": "^4.0.3",
    "@types/prompts": "^2.4.9",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "auvezy-terminal-remote-shared": "workspace:*",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
